            saveData();
            renderContent();
            if (count > 0) {
                showToast(`${count} tagihan paket 8x/12x pertemuan berhasil diterbitkan!`);
            } else {
                showToast('Semua siswa yang mencapai target 8x/12x sudah memiliki tagihan.');
            }
        }

