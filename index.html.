                students: Array.isArray(raw?.students) ? raw.students : defaultData.students,
                classes: Array.isArray(raw?.classes) && raw.classes.length ? raw.classes : defaultData.classes,
                attendances: Array.isArray(raw?.attendances) ? raw.attendances : [],
                invoices: Array.isArray(raw?.invoices) ? raw.invoices : [],
                announcements: Array.isArray(raw?.announcements) ? raw.announcements : [],
                learningMedia: Array.isArray(raw?.learningMedia) ? raw.learningMedia : []
            };

            merged.students = merged.students.map(st => {
                const cIds = Array.isArray(st.classIds) && st.classIds.length
                    ? st.classIds
                    : (st.classId ? [st.classId] : []);
