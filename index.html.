        function loginAsParent(e) {
            e.preventDefault();
            const rawInput = document.getElementById('parent-login-phone').value.trim();
            const cleanInput = rawInput.replace(/\D/g, '');
            if (!cleanInput) return showToast('Masukkan nomor WhatsApp yang terdaftar!', 'error');

            const normalizePhone = (ph) => {
                let d = String(ph || '').replace(/\D/g, '');
                if (d.startsWith('62')) d = '0' + d.slice(2);
                return d;
            };

            const targetNorm = normalizePhone(cleanInput);
            const matchedParents = appData.parents.filter(p => normalizePhone(p.phone) === targetNorm);

            if (matchedParents.length === 0) {
                return showToast('Nomor WhatsApp belum terdaftar. Hubungi Admin Bimbel Pintara.', 'error');
            }

            const parentIds = matchedParents.map(p => p.id);
            const children = appData.students.filter(s => parentIds.includes(s.parentId));
            if (children.length === 0) {
                return showToast('Data siswa untuk nomor wali ini belum ditemukan.', 'error');
            }

            currentRole = 'parent';
            currentUserId = targetNorm;
            selectedParentChildId = children[0].id;
            enterMainApp();
            showToast(`Portal Orang Tua terbuka (${matchedParents[0].name})`);
        }

