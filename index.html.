        function saveData(immediate = false) {
            persistLocalCache();
            if (isApplyingRemoteSnapshot) return;

            const nowTs = Date.now();
            lastRemoteUpdatedAt = nowTs;
            setSyncBadge('saving', 'Menyimpan...');

            const serialized = JSON.stringify({ updatedAt: nowTs, data: appData });

            const doPush = async () => {
                if (cloudReady && cloudStateDocRef) {
                    try {
                        await setDoc(cloudStateDocRef, { payload: serialized, updatedAt: nowTs }, { merge: true });
                        setSyncBadge('live', 'Tersinkron Live');
                    } catch (e) {}
                }
                await pushToPublicRelay(serialized);
            };

            clearTimeout(saveDebounceTimer);
            if (immediate) {
                doPush();
            } else {
                saveDebounceTimer = setTimeout(doPush, 120);
            }
        }

        async function initCloudSync() {
            let firebaseCfg = null;
            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    firebaseCfg = typeof __firebase_config === 'string' ? JSON.parse(__firebase_config) : __firebase_config;
                } else {
                    const customRaw = localStorage.getItem(CUSTOM_CLOUD_KEY);
                    if (customRaw) firebaseCfg = JSON.parse(customRaw);
                }
            } catch (e) {}

            if (firebaseCfg && firebaseCfg.apiKey) {
                try {
                    const app = initializeApp(firebaseCfg);
                    const auth = getAuth(app);
                    const db = getFirestore(app);
                    const appId = typeof __app_id !== 'undefined' ? __app_id : 'bimbel-pintara-prod';

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    onAuthStateChanged(auth, (user) => {
                        if (!user) return;
                        cloudStateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'bimbel_state', sharedSyncId);
                        cloudReady = true;
                        setSyncBadge('live', 'Tersinkron Live');

                        onSnapshot(cloudStateDocRef, (snap) => {
                            if (!snap.exists()) return;
                            const docData = snap.data();
                            if (!docData || !docData.payload) return;
                            try {
                                const parsed = JSON.parse(docData.payload);
                                const remoteTs = Number(parsed.updatedAt || docData.updatedAt || 0);
                                if (remoteTs > lastRemoteUpdatedAt && parsed.data) {
                                    lastRemoteUpdatedAt = remoteTs;
                                    isApplyingRemoteSnapshot = true;
                                    appData = normalizeData(parsed.data);
                                    persistLocalCache();
                                    refreshVisibleViews();
                                    isApplyingRemoteSnapshot = false;
                                }
                            } catch (e) {}
                        });
                    });
                    return;
                } catch (e) {
                    console.warn('Fallback ke relay sync:', e);
                }
            }

            // Sinkronisasi otomatis via Public Relay untuk hosting mandiri / HP orang tua
            const hasCloudData = await pullFromPublicRelay(true);
            if (!hasCloudData) {
                // Jika ruang cloud masih kosong, unggah data awal perangkat ini agar HP lain bisa langsung menariknya
                const initTs = Date.now();
                lastRemoteUpdatedAt = initTs;
                await pushToPublicRelay(JSON.stringify({ updatedAt: initTs, data: appData }));
            }
            setSyncBadge('live', 'Tersinkron Live');
            setInterval(() => pullFromPublicRelay(true), 6000);
        }

