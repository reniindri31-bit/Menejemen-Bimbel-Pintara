        function renderParentPortal() {
            const normalizePhone = (ph) => {
                let d = String(ph || '').replace(/\D/g, '');
                if (d.startsWith('62')) d = '0' + d.slice(2);
                return d;
            };
            const matchedParents = appData.parents.filter(p => normalizePhone(p.phone) === currentUserId);
            const parentIds = matchedParents.map(p => p.id);
            const myChildren = appData.students.filter(s => parentIds.includes(s.parentId));

            if (myChildren.length === 0) {
                return `<div class="bg-white p-8 rounded-2xl text-center text-sm text-slate-500">Data siswa tidak ditemukan.</div>`;
            }

            const activeChild = myChildren.find(c => c.id === selectedParentChildId) || myChildren[0];
            selectedParentChildId = activeChild.id;

            const stats = getStudentAttendanceStats(activeChild.id);

            const childAttendances = appData.attendances.filter(att => {
                if (att.studentId) return att.studentId === activeChild.id;
                return Array.isArray(att.records) && att.records.some(r => r.studentId === activeChild.id);
            });

            const childInvoices = appData.invoices.filter(inv => {
                if (inv.studentId !== activeChild.id) return false;
                const seq = Number(inv.milestoneSeq || 0);
                if (seq === 0) return true;
                return stats.totalHadir >= seq * stats.targetPkg;
            });

            const relevantMedia = appData.learningMedia.filter(m =>
                m.gradeLevel === 'Semua Kelas' || m.gradeLevel === activeChild.grade
            );

            const schedulesHtml = (activeChild.classIds || []).map(cid => {
                const cls = appData.classes.find(c => c.id === cid);
                const slot = activeChild.classSlots && activeChild.classSlots[cid] ? activeChild.classSlots[cid] : 'Sesuai Jadwal Kelas';
                return `<span class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-800 font-bold text-xs">${cls ? cls.name : cid} • ${slot}</span>`;
            }).join('') || '<span class="text-xs text-slate-400">Jadwal sedang diatur oleh admin</span>';

            return `
                <div class="space-y-6 animate-fade-in">
                    <!-- Header Anak & Pemilih Anak -->
                    <div class="bg-gradient-to-r from-indigo-900 to-slate-900 text-white rounded-3xl p-6 shadow-lg flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="space-y-1.5">
                            <span class="px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold">Portal Wali Murid • ${matchedParents[0]?.name || ''}</span>
                            <h2 class="text-2xl font-extrabold">${activeChild.name} <span class="text-base font-medium text-indigo-200">(${activeChild.grade} • ${activeChild.programName})</span></h2>
                            <div class="text-xs text-slate-300">
                                Paket Bimbingan: <strong class="text-amber-300">${stats.targetPkg}x Pertemuan</strong> • Progres Siklus Berjalan: <strong class="text-emerald-300">${stats.currentCycleCount} / ${stats.targetPkg} Hadir</strong> (Total ${stats.totalHadir}x hadir)
                            </div>
                        </div>

                        ${myChildren.length > 1 ? `
                            <div class="flex flex-wrap gap-1.5">
                                ${myChildren.map(ch => `
                                    <button onclick="selectedParentChildId='${ch.id}'; renderContent()" class="px-3.5 py-2 rounded-xl text-xs font-bold ${ch.id === activeChild.id ? 'bg-amber-400 text-slate-950' : 'bg-white/10 text-white'}">
                                        ${ch.name}
                                    </button>
                                `).join('')}
                            </div>
                        ` : ''}
                    </div>

                    ${appData.announcements.length > 0 ? `
                        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 space-y-2">
                            <div class="flex items-center gap-2 text-xs font-extrabold text-amber-900">
                                <i class="ph-fill ph-megaphone text-base text-amber-600"></i> Papan Pengumuman ${appData.profile.name}
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                                ${appData.announcements.map(ann => `
                                    <div class="p-3 rounded-xl bg-white border border-amber-200/80 text-xs">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="font-extrabold text-slate-900">${ann.title}</span>
                                            <span class="text-[11px] text-slate-400">${ann.date}</span>
                                        </div>
                                        <p class="text-slate-600 mt-1">${ann.content}</p>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    ` : ''}

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- Kolom Kiri: Jadwal & Laporan Belajar Anak -->
                        <div class="lg:col-span-7 space-y-5">
                            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-2.5">
                                <h3 class="text-sm font-extrabold text-slate-900">Jadwal Rombel & Jam Sesi ${activeChild.name}</h3>
                                <div class="flex flex-wrap gap-2">${schedulesHtml}</div>
                            </div>

                            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-4">
                                <div class="flex items-center justify-between">
                                    <h3 class="text-base font-extrabold text-slate-900">Riwayat Belajar, Foto & Evaluasi ${activeChild.name}</h3>
                                    <span class="text-xs font-bold text-indigo-600">${childAttendances.length} Pertemuan</span>
                                </div>

                                ${childAttendances.length === 0 ? `
                                    <div class="p-6 text-center text-xs text-slate-400 border border-dashed border-slate-200 rounded-2xl">
                                        Belum ada catatan pertemuan untuk ${activeChild.name}.
                                    </div>
                                ` : `
                                    <div class="space-y-3">
                                        ${childAttendances.map(att => {
                                            const cls = appData.classes.find(c => c.id === att.classId);
                                            const stStatus = att.status || (att.records?.find(r => r.studentId === activeChild.id)?.status) || 'Hadir';
                                            return `
                                                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs space-y-2.5">
                                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                                        <span class="font-extrabold text-slate-900">${att.date} • ${cls ? cls.name : ''} ${att.sessionSlot ? `(${att.sessionSlot})` : ''}</span>
                                                        <span class="px-2.5 py-0.5 rounded-full font-bold ${stStatus === 'Hadir' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${stStatus}</span>
                                                    </div>
                                                    <div><strong>Materi Belajar:</strong> ${att.topic || '-'}</div>
                                                    ${att.evaluation ? `<div class="p-3 rounded-xl bg-white border border-slate-200/70"><strong>Evaluasi Tutor:</strong> ${att.evaluation}</div>` : ''}
                                                    ${att.photoData ? `
                                                        <div class="space-y-2 pt-1">
                                                            <img src="${att.photoData}" onclick="openPhotoLightbox('${att.photoData}', '${activeChild.name} - ${att.date}')" class="h-44 w-full sm:w-64 object-cover rounded-xl border border-slate-200 cursor-pointer">
                                                            <div>
                                                                <button type="button" onclick="downloadChildPhoto('${att.id}', '${activeChild.name.replace(/'/g, '')}')" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold inline-flex items-center gap-1.5">
                                                                    <i class="ph-bold ph-download-simple"></i> Unduh Foto Ananda
                                                                </button>
                                                            </div>
                                                        </div>
                                                    ` : ''}
                                                </div>
                                            `;
                                        }).join('')}
                                    </div>
                                `}
                            </div>
                        </div>

                        <!-- Kolom Kanan: Tagihan SPP & Media Pembelajaran -->
                        <div class="lg:col-span-5 space-y-5">
                            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-3">
                                <div class="flex items-center justify-between">
                                    <h3 class="text-base font-extrabold text-slate-900">Tagihan & Kuitansi SPP</h3>
                                    <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-[11px] font-bold">Paket ${stats.targetPkg}x</span>
                                </div>

                                ${childInvoices.length === 0 ? `
                                    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-xs text-emerald-900 space-y-1">
                                        <div class="font-extrabold">Belum Ada Tagihan Jatuh Tempo</div>
                                        <p>Ananda ${activeChild.name} baru mengikuti <strong>${stats.currentCycleCount} dari ${stats.targetPkg} pertemuan</strong>. Invoice SPP akan muncul otomatis setelah mencapai <strong>${stats.targetPkg}x kehadiran</strong>.</p>
                                    </div>
                                ` : `
                                    <div class="space-y-3">
                                        ${childInvoices.map(inv => `
                                            <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50 text-xs space-y-2">
                                                <div class="flex items-center justify-between">
                                                    <span class="font-bold text-slate-500">${inv.id}</span>
                                                    <span class="px-2.5 py-0.5 rounded-full font-bold ${inv.status === 'Lunas' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">${inv.status}</span>
                                                </div>
                                                <div class="font-extrabold text-slate-900">${inv.description}</div>
                                                <div class="text-base font-extrabold text-indigo-700">${formatRupiah(inv.amount)}</div>
                                                <div class="flex flex-wrap gap-2 pt-1">
                                                    ${inv.status === 'Belum Bayar' ? `
                                                        <button onclick="parentConfirmPayment('${inv.id}')" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold">Konfirmasi Sudah Transfer</button>
                                                    ` : ''}
                                                    <button onclick="downloadReceiptPDF('${inv.id}')" class="px-3.5 py-2 rounded-xl bg-white border border-slate-300 text-slate-800 font-bold">Unduh Kuitansi</button>
                                                </div>
                                            </div>
                                        `).join('')}
                                    </div>
                                `}
                            </div>

                            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-3">
                                <h3 class="text-base font-extrabold text-slate-900">Materi & Modul Belajar (${activeChild.grade})</h3>
                                ${relevantMedia.length === 0 ? `<p class="text-xs text-slate-400">Belum ada modul tambahan.</p>` : `
                                    <div class="space-y-2.5">
                                        ${relevantMedia.map(m => `
                                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs space-y-1.5">
                                                <div class="font-extrabold text-slate-900">${m.title}</div>
                                                <p class="text-slate-600">${m.notes || ''}</p>
                                                <a href="${m.url}" target="_blank" rel="noopener" class="inline-block px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold">Buka Materi</a>
                                            </div>
                                        `).join('')}
                                    </div>
                                `}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function parentConfirmPayment(invId) {
            const inv = appData.invoices.find(i => i.id === invId);
            if (!inv) return;
            inv.status = 'Menunggu Verifikasi';
            inv.proofNote = `Dikonfirmasi wali murid pada ${new Date().toISOString().slice(0, 10)}`;
            saveData();
            renderContent();
            showToast('Konfirmasi pembayaran terkirim ke Admin Bimbel Pintara!');
        }

        function downloadChildPhoto(attId, studentName) {
            const att = appData.attendances.find(a => a.id === attId);
            if (!att || !att.photoData) return showToast('Foto tidak tersedia.', 'error');
            const link = document.createElement('a');
            link.href = att.photoData;
            link.download = `Belajar_${studentName || 'Siswa'}_${att.date || 'Pintara'}.jpg`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Mengunduh foto kegiatan belajar ananda...');
        }

        // =====================================================================
        // BACKUP & RESTORE DATA JSON
        // =====================================================================
        function openBackupModal() {
            openModal(`
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-base font-extrabold text-slate-900">Cadangan & Pulihkan Data (JSON)</h3>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-slate-700 text-xl">&times;</button>
                </div>
                <div class="space-y-4 text-xs">
                    <p class="text-slate-600">Unduh file cadangan JSON secara berkala untuk menyimpan seluruh data siswa, rombel, absensi, foto, dan keuangan.</p>
                    <button onclick="downloadBackupJSON()" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold">
                        Unduh File Cadangan (.json)
                    </button>
                    <div class="border-t border-slate-200 pt-3 space-y-2">
                        <label class="block font-bold text-slate-700">Pulihkan dari File Cadangan (.json):</label>
                        <input type="file" accept=".json" onchange="restoreBackupJSON(this)" class="w-full text-xs">
                    </div>
                </div>
            `);
        }

        function downloadBackupJSON() {
            const blob = new Blob([JSON.stringify(appData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Backup_Bimbel_Pintara_${new Date().toISOString().slice(0, 10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('File cadangan JSON berhasil diunduh!');
        }

        function restoreBackupJSON(input) {
            const file = input.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    appData = normalizeData(parsed);
                    saveData();
                    closeModal();
                    refreshVisibleViews();
                    showToast('Data berhasil dipulihkan dari file cadangan!');
                } catch (err) {
                    showToast('File JSON tidak valid!', 'error');
                }
            };
            reader.readAsText(file);
        }

        // ---------------------------------------------------------------------
        // EKSPOS FUNGSI KE GLOBAL WINDOW UNTUK ONCLICK / ONSUBMIT HTML
        // ---------------------------------------------------------------------
        Object.assign(window, {
            showAuthPanel, updatePublicPricePreview, handlePublicRegistration,
            toggleTutorSelect, handleStaffLogin, loginAsParent, logout,
            switchTab, renderContent, closeModal, openPhotoLightbox, closePhotoLightbox,
            openAddStudentModal, saveNewStudent, openEditStudentModal, saveEditedStudent,
            deleteStudent, confirmDeleteStudent,
            openManageClassModal, saveClassAssignments,
            onAttendanceClassChange, onAttendanceStudentChange, previewAttendancePhotoInput,
            submitSingleStudentAttendance,
            addLearningMedia, deleteMedia,
            openEditAttendanceModal, saveEditedAttendance, deleteAttendance, confirmDeleteAttendance,
            sendInvoiceViaWA, sendAttendanceReportViaWA,
            runAutoGenerateAllMilestoneInvoices, deleteInvoice, confirmDeleteInvoice,
            markInvoicePaid, openCreateManualInvoiceModal, saveManualInvoice, downloadReceiptPDF,
            saveProfileSettings, addAnnouncement, deleteAnnouncement, copyParentShareMessage,
            saveCustomCloudConfig, clearCustomCloudConfig,
            parentConfirmPayment, downloadChildPhoto, openBackupModal, downloadBackupJSON, restoreBackupJSON,
            forceSyncNow
        });

        // Mulai Inisialisasi Halaman & Sinkronisasi Cloud
        initAuthScreen();
        initCloudSync();
    </script>
</body>
</html>
