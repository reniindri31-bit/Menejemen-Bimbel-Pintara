        function saveClassAssignments(e, classId) {
            e.preventDefault();
            const cls = appData.classes.find(c => c.id === classId);
            if (!cls) return;
            cls.tutorId = document.getElementById('cls-tutor-sel').value;
            cls.room = document.getElementById('cls-room-inp').value.trim();

            const checkedIds = new Set();
            document.querySelectorAll('input[name="cls-member-chk"]:checked').forEach(chk => checkedIds.add(chk.value));

            appData.students.forEach(st => {
                if (!Array.isArray(st.classIds)) st.classIds = [];
                if (!st.classSlots) st.classSlots = {};

                if (checkedIds.has(st.id)) {
                    if (!st.classIds.includes(classId)) st.classIds.push(classId);
                    const slotVal = document.getElementById(`cls-st-slot-${st.id}`)?.value || '';
                    if (slotVal) st.classSlots[classId] = slotVal;
                    else delete st.classSlots[classId];
                } else {
                    st.classIds = st.classIds.filter(id => id !== classId);
                    delete st.classSlots[classId];
                }
                st.classId = st.classIds[0] || '';
            });

            saveData();
            closeModal();
            renderContent();
            showToast(`Anggota & jam sesi ${cls.name} berhasil diperbarui!`);
        }

