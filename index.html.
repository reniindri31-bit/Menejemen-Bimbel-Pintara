                </div>
                <div>
                    <h1 id="auth-brand-name" class="text-lg sm:text-xl font-extrabold tracking-tight text-white">Bimbel Pintara</h1>
                    <p id="auth-brand-owner" class="text-xs text-amber-300 font-medium">Owner: Reni Indriyani, S. Pd., A. H.</p>
