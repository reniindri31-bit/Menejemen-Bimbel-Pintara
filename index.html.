        function compressAttendancePhoto(file) {
            return new Promise((resolve) => {
                if (!file) return resolve('');
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxW = 560;
                        const scale = img.width > maxW ? maxW / img.width : 1;
                        canvas.width = Math.round(img.width * scale);
                        canvas.height = Math.round(img.height * scale);
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                        resolve(canvas.toDataURL('image/jpeg', 0.58));
                    };
                    img.onerror = () => resolve('');
                    img.src = ev.target.result;
                };
                reader.onerror = () => resolve('');
                reader.readAsDataURL(file);
            });
        }

        function formatWaPhone(rawPhone) {
            let digits = String(rawPhone || '').replace(/\D/g, '');
            if (!digits) return '';
            if (digits.startsWith('0')) digits = '62' + digits.slice(1);
            else if (!digits.startsWith('62')) digits = '62' + digits;
            return digits;
        }

        function openWhatsAppMessage(phone, message) {
            const formatted = formatWaPhone(phone);
            if (!formatted) return showToast('Nomor WhatsApp wali murid belum tersedia!', 'error');
            const url = `https://wa.me/${formatted}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank', 'noopener');
        }

