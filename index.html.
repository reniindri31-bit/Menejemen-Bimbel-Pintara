        async function saveEditedAttendance(e, attId) {
            e.preventDefault();
            const att = appData.attendances.find(a => a.id === attId);
            if (!att) return;
            att.date = document.getElementById('edit-att-date').value;
            att.status = document.getElementById('edit-att-status').value;
            att.sessionSlot = document.getElementById('edit-att-slot').value;
            att.topic = document.getElementById('edit-att-topic').value.trim();
            att.evaluation = document.getElementById('edit-att-eval').value.trim();
            att.records = [{ studentId: att.studentId, status: att.status }];

            const newPhotoFile = document.getElementById('edit-att-photo')?.files?.[0];
            if (newPhotoFile) {
                att.photoData = await compressAttendancePhoto(newPhotoFile);
            }

            if (att.status === 'Hadir' && att.studentId) {
                syncSessionMilestoneInvoices(att.studentId);
            }
            saveData();
            closeModal();
            renderContent();
            showToast('Catatan absensi & evaluasi berhasil diperbarui!');
        }

        function deleteAttendance(attId) {
            const att = appData.attendances.find(a => a.id === attId);
            if (!att) return;
            const st = appData.students.find(s => s.id === att.studentId);
            openModal(`
                <div class="space-y-4 text-xs">
                    <h3 class="text-base font-extrabold text-slate-900">Hapus Riwayat Pertemuan?</h3>
