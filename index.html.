        function getStudentAttendanceStats(studentId) {
            const st = appData.students.find(s => s.id === studentId);
            const targetPkg = st && Number(st.sessionPackage) === 12 ? 12 : 8;
            let totalHadir = 0;

            appData.attendances.forEach(att => {
                if (att.studentId === studentId) {
                    if ((att.status || 'Hadir') === 'Hadir') totalHadir++;
                } else if (Array.isArray(att.records)) {
                    const rec = att.records.find(r => r.studentId === studentId && r.status === 'Hadir');
                    if (rec) totalHadir++;
                }
            });

            const completedCycles = Math.floor(totalHadir / targetPkg);
            const currentCycleCount = totalHadir % targetPkg;
            return { totalHadir, targetPkg, completedCycles, currentCycleCount };
        }

        function syncSessionMilestoneInvoices(studentId) {
            const st = appData.students.find(s => s.id === studentId);
            if (!st) return false;
            const stats = getStudentAttendanceStats(studentId);
            if (stats.completedCycles < 1) return false;

            let createdAny = false;
            for (let seq = 1; seq <= stats.completedCycles; seq++) {
                const alreadyExists = appData.invoices.some(inv =>
                    inv.studentId === studentId && Number(inv.milestoneSeq || 0) === seq
                );
                if (!alreadyExists) {
                    const nowMonth = new Date().toISOString().slice(0, 7);
                    appData.invoices.unshift({
                        id: `INV-${nowMonth.replace('-', '')}-${String(Math.floor(100 + Math.random() * 900))}`,
                        studentId: st.id,
                        month: nowMonth,
                        description: `SPP Paket ${stats.targetPkg}x Pertemuan (Siklus ke-${seq}) - ${st.name}`,
                        amount: Number(st.tariff || 100000),
                        paidAmount: 0,
                        status: 'Belum Bayar',
                        paidDate: '',
                        proofNote: '',
                        milestoneSeq: seq
                    });
                    createdAny = true;
                }
            }
            return createdAny;
        }

        function runAutoGenerateAllMilestoneInvoices() {
            let count = 0;
            appData.students.filter(s => s.status === 'Aktif').forEach(st => {
                if (syncSessionMilestoneInvoices(st.id)) count++;
