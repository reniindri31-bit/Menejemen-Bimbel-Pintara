        function handlePublicRegistration(e) {
            e.preventDefault();
            const studentName = document.getElementById('reg-student-name').value.trim();
            const grade = document.getElementById('reg-grade').value;
            const programName = document.getElementById('reg-program').value;
            const sessionPackage = Number(document.getElementById('reg-session-package').value || 8);
            const tariff = Number(document.getElementById('reg-tariff').value || 100000);
            const parentName = document.getElementById('reg-parent-name').value.trim();
            const parentPhone = document.getElementById('reg-parent-phone').value.trim().replace(/\s+/g, '');

            if (!studentName || !parentName || !parentPhone) {
                return showToast('Lengkapi semua kolom wajib pendaftaran!', 'error');
            }

            let parent = appData.parents.find(p => p.phone.replace(/\D/g, '') === parentPhone.replace(/\D/g, ''));
            if (!parent) {
                parent = { id: 'P-' + Date.now(), name: parentName, phone: parentPhone };
                appData.parents.push(parent);
            }

            const defaultClassId = appData.classes[0]?.id || '';
            const newStudent = {
                id: 'S-' + Date.now(),
                name: studentName,
                grade,
                programName,
                tariff,
                sessionPackage,
                packageType: 'Bulanan',
                parentId: parent.id,
                classId: defaultClassId,
                classIds: defaultClassId ? [defaultClassId] : [],
                classSlots: {},
                status: 'Aktif',
                joinDate: new Date().toISOString().slice(0, 10)
            };
            appData.students.push(newStudent);

            const regTotal = Number(appData.fees.registration || 0) + Number(appData.fees.module || 0);
            if (regTotal > 0) {
                const nowMonth = new Date().toISOString().slice(0, 7);
                appData.invoices.unshift({
                    id: `INV-REG-${String(Math.floor(100 + Math.random() * 900))}`,
                    studentId: newStudent.id,
                    month: nowMonth,
                    description: `Biaya Pendaftaran & Modul Awal - ${studentName}`,
                    amount: regTotal,
                    paidAmount: 0,
                    status: 'Belum Bayar',
                    paidDate: '',
                    proofNote: '',
                    milestoneSeq: 0
                });
            }

            saveData();
            e.target.reset();
            showAuthPanel('parent');
            document.getElementById('parent-login-phone').value = parentPhone;
            showToast(`Pendaftaran ${studentName} berhasil! Silakan buka Portal Orang Tua.`);
