        async function submitSingleStudentAttendance(e) {
            e.preventDefault();
            const classId = document.getElementById('att-class-select').value;
            const studentId = document.getElementById('att-student-select')?.value;
            const date = document.getElementById('att-date').value;
            const status = document.getElementById('att-status').value;
            const sessionSlot = document.getElementById('att-session-slot').value;
            const topic = document.getElementById('att-topic').value.trim();
            const evaluation = document.getElementById('att-evaluation').value.trim();
            const fileInput = document.getElementById('att-photo-file');

            if (!studentId) return showToast('Pilih siswa terlebih dahulu!', 'error');

            const photoData = await compressAttendancePhoto(fileInput?.files?.[0]);

            appData.attendances.unshift({
                id: 'ATT-' + Date.now(),
                classId,
                studentId,
                date,
                status,
                sessionSlot,
                topic,
                evaluation,
                photoData,
                records: [{ studentId, status }]
            });

            let generatedInvoice = false;
            if (status === 'Hadir') {
                generatedInvoice = syncSessionMilestoneInvoices(studentId);
            }

            saveData();
            renderContent();

            const st = appData.students.find(s => s.id === studentId);
            if (generatedInvoice) {
                showToast(`Absensi ${st?.name} tersimpan & Tagihan SPP otomatis terbit!`);
            } else {
                showToast(`Laporan belajar ${st?.name} berhasil disimpan!`);
            }
        }

