        async function pushToPublicRelay(payloadStr) {
            let synced = false;

            // Jalur 1: ntfy.sh CORS-enabled message stream (sangat stabil di seluruh provider HP Indonesia & Netlify)
            try {
                const resNtfy = await fetch(getNtfyPublishUrl(), {
                    method: 'POST',
                    headers: {
                        'Title': 'PINTARA_SYNC',
                        'Cache': 'yes'
                    },
                    body: payloadStr
                });
                if (resNtfy.ok) synced = true;
            } catch (e) {}

            // Jalur 2: kvdb.io key-value store
            try {
                const resKv = await fetch(getRelayEndpoint(), {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain' },
                    body: payloadStr
                });
                if (resKv.ok) synced = true;
            } catch (e) {}

            if (synced) {
                setSyncBadge('live', 'Tersinkron Live');
            } else {
                setSyncBadge('local', 'Tersimpan Lokal');
            }
            return synced;
        }

        async function pullFromPublicRelay(silent = true) {
            if (isApplyingRemoteSnapshot) return false;
            let gotRemote = false;

            // Cek Jalur 1: ntfy.sh cached stream
            try {
                const res = await fetch(getNtfyTopicUrl('24h'), { cache: 'no-store' });
                if (res.ok) {
                    const rawLines = await res.text();
                    const lines = rawLines.trim().split('\n').filter(Boolean);
                    for (let i = lines.length - 1; i >= 0; i--) {
                        try {
                            const wrapper = JSON.parse(lines[i]);
                            if (!wrapper || !wrapper.message) continue;
                            const parsed = JSON.parse(wrapper.message);
                            if (parsed && parsed.data) {
                                const remoteTs = Number(parsed.updatedAt || 0);
                                if (remoteTs > lastRemoteUpdatedAt) {
                                    lastRemoteUpdatedAt = remoteTs;
                                    isApplyingRemoteSnapshot = true;
                                    appData = normalizeData(parsed.data);
                                    persistLocalCache();
                                    refreshVisibleViews();
                                    isApplyingRemoteSnapshot = false;
                                    if (!silent) showToast('Data terbaru dari cloud berhasil dimuat!');
                                }
                                gotRemote = true;
                                break;
                            }
                        } catch (innerErr) {}
                    }
                }
            } catch (e) {}

            // Cek Jalur 2: kvdb.io
            if (!gotRemote) {
                try {
                    const res2 = await fetch(getRelayEndpoint(), { cache: 'no-store' });
                    if (res2.ok) {
                        const text = await res2.text();
                        if (text && text.trim().length > 10) {
                            const parsed = JSON.parse(text);
                            if (parsed && parsed.data) {
                                const remoteTs = Number(parsed.updatedAt || 0);
                                if (remoteTs > lastRemoteUpdatedAt) {
                                    lastRemoteUpdatedAt = remoteTs;
                                    isApplyingRemoteSnapshot = true;
                                    appData = normalizeData(parsed.data);
                                    persistLocalCache();
                                    refreshVisibleViews();
                                    isApplyingRemoteSnapshot = false;
                                    if (!silent) showToast('Data terbaru dari cloud berhasil dimuat!');
                                }
                                gotRemote = true;
                            }
                        }
                    }
                } catch (e) {}
            }

            setSyncBadge('live', 'Tersinkron Live');
            return gotRemote;
        }

